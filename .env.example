# ==========================================
# Coursenva - Environment Variable Template
# ==========================================
# Copy this file to .env.local and insert your actual API keys.
# DO NOT put real API keys directly in this .env.example file.

# 1. Google Gemini API Key (Optional)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Mistral AI API Key (Optional)
# Obtain from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# 3. Tavily Search API Key (Optional)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 4. Google Serper Search API Key (Optional)
# Obtain from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here